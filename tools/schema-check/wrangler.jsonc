{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neverranked-schema-check",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-09",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "check.neverranked.com", "custom_domain": true }
  ],
  // neverranked-app, the dashboard's database. The free-check tables
  // (free_check_scans, free_check_leads, free_check_events) are created by
  // dashboard/migrations/0131. No migrations_dir here on purpose: the schema
  // is single-sourced in the dashboard, the same as the outreach worker.
  // Never run `d1 migrations apply` from this folder.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neverranked-app",
      "database_id": "def9e1a6-3d37-4a2c-b797-7c5de2cff1ef"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LEADS",
      "id": "d95d981b0ee5482a8d49e1f56105670e"
    }
  ],
  "triggers": {
    "crons": ["0 14 * * *"]
  }
}
